{
  "name": "ipscscore-electron",
  "version": "1.0.0",
  "private": true,
  "description": "IPSC/USPSA Scoring Desktop Application",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "dev:watch": "tsc --watch & electron .",
    "build": "tsc",
    "build:mac": "tsc && electron-builder --mac",
    "build:win": "tsc && electron-builder --win",
    "build:linux": "tsc && electron-builder --linux",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}